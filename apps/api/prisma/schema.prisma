generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Board {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  level       Int
  complexity  Complexity
  imageUrl    String
  coordinates Coordinate[]
  rankings    ranking[]
}

model Character {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  imageUrl    String
  iconUrl     String
  description String
  coordinates Coordinate[]
}

model Coordinate {
  board   Board @relation(fields: [boardId], references: [id])
  boardId Int

  character   Character @relation(fields: [characterId], references: [id])
  characterId Int

  charXmin Decimal
  charXmax Decimal
  charYmin Decimal
  charYmax Decimal

  @@id([boardId, characterId])
}

model ranking {
  id         Int      @id @default(autoincrement())
  board      Board    @relation(fields: [boardId], references: [id])
  boardId    Int
  playerName String   @db.VarChar(50)
  time       Int
  createdAt  DateTime @default(now())
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

enum Complexity {
  Easy
  Normal
  Hard
}
